{
  "name": "product-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['.next', 'next-env.d.ts', 'tsconfig.tsbuildinfo']) rmSync(path, { recursive: true, force: true });\""
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "antd": "^6.6.8",
    "next": "^16.4.3",
    "product-interface": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}

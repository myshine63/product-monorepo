{
  "name": "monorepo-product",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm monorepo workspace",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=product-web",
    "dev:backend": "turbo run dev --filter=product-backend",
    "build:web": "turbo run build --filter=product-web",
    "build:backend": "turbo run build --filter=product-backend"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}

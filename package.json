{
  "name": "monorepo-product",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm monorepo workspace",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm --parallel --filter product-web --filter product-backend run dev",
    "dev:web": "pnpm --filter product-web dev",
    "dev:backend": "pnpm --filter product-backend dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
